DATABASE_URL="mysql://root@127.0.0.1:3318/bhga_web"
PORT=3021
# The website's address(es), comma-separated. Used for CORS.
CLIENT_URL=http://localhost:3020
# Long random string for the /admin inbox. Generate with: openssl rand -hex 24
ADMIN_API_KEY=

# Where new enquiries, applications and consultation requests are emailed.
ADMISSIONS_EMAIL=bethelhouseofgodacademy@gmail.com

# Brevo transactional email. Without BREVO_API_KEY, emails print to this console instead.
# The sender address must be verified in Brevo (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=bethelbooks@nkashtech.com
BREVO_SENDER_NAME=Bethel House of God Academy
# Outside production, only these comma-separated addresses get real email; the rest print to this console.
EMAIL_TEST_ALLOW=
